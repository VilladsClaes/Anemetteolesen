<?xml version="1.0" encoding="utf-8"?>
<!-- IIS hos Simply.com: appen køres som selvstændig proces bag IIS (out-of-process).
     Startlog skrives til logs\stdout*.log, så fejl ved opstart kan findes via FTP. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
