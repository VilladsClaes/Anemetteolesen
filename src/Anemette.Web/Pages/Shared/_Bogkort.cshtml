@model Bog
<li class="bogkort">
    <a class="omslag" href="/boeger/@Model.Slug" tabindex="-1" aria-hidden="true"><partial name="_Omslag" model="Model" /></a>
    <h3><a href="/boeger/@Model.Slug">@Model.Titel</a></h3>
    @if (Model.Status == BogStatus.KommerSnart)
    {
        <p><span class="status status-snart">Kommer snart</span></p>
    }
    else
    {
        <p class="pris">@Tekst.Kr(Model.Pris)</p>
        @if (Model.KanBestilles)
        {
            <form method="post" asp-page="/Indkoeb/Index" asp-page-handler="Tilfoej">
                <input type="hidden" name="bogId" value="@Model.Id">
                <button type="submit" class="knap knap-lille">Læg i kurven</button>
            </form>
        }
        else
        {
            <p><span class="status status-udsolgt">Udsolgt</span></p>
        }
    }
</li>
