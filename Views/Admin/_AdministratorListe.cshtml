@model IEnumerable<Anemette.Models.tblAdmin>

@*<p>
    @Html.ActionLink("Opret ny", "OpretAdministrator")
</p>*@
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Brugernavn)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Password)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Salt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.BrugerEmail)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Brugernavn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Password)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Salt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BrugerEmail)
            </td>
            <td>
                @Html.ActionLink("Edit", "EditerAdministrator", new { id = item.ID }) |
                @Html.ActionLink("Details", "DetaljeAdministrator", new { id = item.ID }) |
                @Html.ActionLink("Delete", "SletAdministrator", new { id = item.ID })
            </td>
        </tr>
    }

</table>



