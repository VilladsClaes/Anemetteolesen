@model Anemette.Models.ViewModel




    <div class="p-5">
        <h2>Velkommen @Session["LoginBruger"].ToString()</h2>

        <h3>Administratorer:</h3>
        @Html.ActionLink("Opret ny administrator", "OpretAdministrator", "Admin")
        @Html.ActionLink("Se din profil", "DetaljeAdministrator", "Admin", new { id = Session["BrugerID"] })
        @Html.ActionLink("Slet din profil", "SletAdministrator", "Admin", new { id = Session["BrugerID"] })
        <h3>Events:</h3>
        @Html.ActionLink("Opret nyt kursus", "OpretKursus", "Event")
        @Html.ActionLink("Se alle kurser", "Index", "Event")
        <h3></h3>


        <p>
            Der er nu tilmeldt <span class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;">@Model.Nyhedsbrevstilmeldte.Count </span> personer til nyhedsbrev
        </p>

        <p>
            Der er planlagt <span class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;">@Model.Events.Count </span> kurser
        </p>

        <p>
            Der er <span class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;">@Model.DeltagerTilmeldings.Count </span> deltagere på alle events
        </p>

        <a class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;" href="@Url.Action("Create", "Bestyrelse")">Opret nyt bestyrelsesmedlem</a>
        <a class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;" href="@Url.Action("Create", "Event")">Opret nyt løbeevent</a>
        <a class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;" href="@Url.Action("OpretBruger", "Login")">Opret ny webadministrator</a>
        <a class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;" href="@Url.Action("Index", "Nyhedsbrev")">Se mailinglist</a>
        <a class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;" href="@Url.Action("Create", "Sponsor")">Tilføj sponsor</a>
        <a class="btn text-uppercase text-white rounded-0" style="background-color: #cb4046; font-weight: 800; color: white !important;" href="@Url.Action("Create", "Tilmelding")">Opret ny eventdeltager</a>
    </div>

@Html.Action("_AdministratorListe")