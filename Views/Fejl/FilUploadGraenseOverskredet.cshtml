@{
    ViewBag.Title = "Filen er for stor";
}
<h2>
    Beklager men de filer du har forsøgt at uploade er større end ham der har lavet hjemmesiden har indstillet grænsen til.
    Du kan ringe til 60614309 og bede om at få det ændret, men det ville være bedre bare at gå tilbage og vælge nogle mindre filer istedet.
</h2>
<small>Fejlkoden er 404.13</small>

<div class="list-header clearfix">
    <span>Error</span>
</div>
<div class="list-sfs-holder">
    <div class="alert alert-error">
        An unexpected error has occurred. Please contact the system administrator.
    </div>
    @if (Model != null && HttpContext.Current.IsDebuggingEnabled)
    {
        <div>
            <p>
                <b>Exception:</b> @Model.Exception.Message<br />
                <b>Controller:</b> @Model.ControllerName<br />
                <b>Action:</b> @Model.ActionName
            </p>
            <div style="overflow:scroll">
                <pre>
                    @Model.Exception.StackTrace
                </pre>
            </div>
        </div>
    }
</div>