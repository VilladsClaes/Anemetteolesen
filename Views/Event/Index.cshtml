@model IEnumerable<Anemette.Models.tblEvent>

@if (@Session["LoginBruger"] != null)
{
    <p>
        @Html.ActionLink("Opret et nyt kursus", "OpretKursus")
    </p>
}
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EventOverskrift)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventDato)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventBeskrivelse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventPris)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventPladser)
            </th>
            <th>
                Billede (ud af flere)
            </th>
            @*<th>
                    @Html.DisplayNameFor(model => model.EventDistance)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.tblEventRegion.Region)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.tblSponsor.SponsorNavn)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.tblType.Type)
                </th>*@
            @if (@Session["LoginBruger"] != null)
            {
                <th>Administration</th>
            }

        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.EventOverskrift)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EventDato)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EventBeskrivelse)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EventPris)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EventPladser)
                </td>

                @* Billede *@
                <td>
                    @if (item.tblBilledes.Where(b => b.FK_Event == item.ID).Any())
                    {
                        <img src="~/Uploads/Thumbnails/@item.tblBilledes.Where(b => b.FK_Event == item.ID).FirstOrDefault().BilledeFil" alt="Billede af @item.tblBilledes.Where(b => b.FK_Event == item.ID).FirstOrDefault().BilledeAlternativTekst" />

                    }
                    else
                    {
                        <p>Der er intet billede</p>
                    }
                </td>

                @*<td>
                        @Html.DisplayFor(modelItem => item.EventDistance)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.tblEventRegion.Region)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.tblSponsor.SponsorNavn)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.tblType.Type)
                    </td>*@
                @if (@Session["LoginBruger"] != null)
                {
                    <td>
                        @Html.ActionLink("Ændr", "EditKursus", new { id = item.ID }) |
                        @Html.ActionLink("Se detaljer", "EnkeltKursus", new { id = item.ID }) |
                        @Html.ActionLink("slet", "SletKursus", new { id = item.ID })
                    </td>
                }

            </tr>
        }

    </table>
