@model Anemette.Models.MailViewModel
@{
    ViewBag.Title = "Kontaktformular";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}


<div class="container" id="kontaktformular">
    <form id="formular"  action="/Home/ContactForm" method="post">
        @Html.AntiForgeryToken()
        <h3>@ViewBag.Titlet</h3>
        <h4>
           
             Hvis du ikke har mulighed for at skrive en mail eller ringe, så brug denne formular til at skrive til mig
        </h4>
        <h4 class="text-danger">@Model.Message</h4>
        <fieldset>
            @*<label for="MailName">Dit fornavn:</label>*@
            <input  placeholder="Skriv dit navn" type="text" tabindex="1" required autofocus name="MailName" id="MailName" />
            
        </fieldset>
        <fieldset>
            @*<label for="MailAdressFrom">Din email</label>*@
            <input placeholder="Din emailadresse" type="email" tabindex="2" required name="MailAdressFrom" id="MailAdressFrom" value="" />      
        </fieldset>
        <fieldset>
            <input placeholder="Dit telefonnummer" type="tel" name="MailTelefon" id="MailTelefon" tabindex="3" required >
        </fieldset>
        <fieldset>
            @*<label for="MailSubject">Emne:</label>*@
            <input type="text" placeholder="Emne"  tabindex="4" required name="MailSubject" id="MailSubject" />
            
        </fieldset>
        <fieldset>
            @*<label for="MailBody">Skriv her</label>*@
            <textarea name="MailBody" id="MailBody" placeholder="Skriv din henvendelse her" tabindex="5" required></textarea>            
        </fieldset>
        <fieldset>           
            <button type="submit" name="SendMail" id="contact-submit" data-submit="...Sending">Send beskeden</button>
        </fieldset>
    </form>


</div>


