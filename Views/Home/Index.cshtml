
@{
    
    Anemette.Models.DatabaseEntities db = new Anemette.Models.DatabaseEntities();
}



    <div class="row">
       

        @* Store knapper til sider *@
        <div class="card-deck">

            @* __________________________________________BOG PÅ FORSIDEN_______________________________________ *@
            <div class="card">
                @{
                    //Tilfældig bog; fremhævning
                    Anemette.Models.tblProdukt RandomBog = new Anemette.Models.tblProdukt();
                    //Vælg en tilfældig bog ved at springe et tilfældigt antal over (virker på både MySQL og MSSQL)
                    var bogKandidater = db.tblProdukts.Where(j => j.tblProduktKategori.ID == 1 && j.Navn.Length > 2 || j.Antal.Value > 0);
                    var antalKandidater = bogKandidater.Count();
                    RandomBog = antalKandidater == 0 ? null : bogKandidater.OrderBy(j => j.ID).Skip(new Random().Next(antalKandidater)).FirstOrDefault();
                }
                @if (RandomBog == null)
                {
                    <div class="card-body"><h5 class="card-title">Bøgerne er på vej</h5></div>
                }
                else
                {
                if (RandomBog.tblBilledes.Where(b => b.FK_Produkt == RandomBog.ID).Any())
                {
                    <img class="card-img-top " src="~/Uploads/@RandomBog.tblBilledes.Where(b => b.FK_Produkt == RandomBog.ID).FirstOrDefault().BilledeFil" alt="Card image cap">

                }
                else
                {
                    <img class="card-img-top" src="~/Uploads/ingenbillede.svg" alt="Der mangler et billede til dette produkt">
                }
                <div class="card-body">
                    <h5 class="card-title">
                        @RandomBog.Navn
                        @Html.ActionLink("Køb denne bog", "TilfojKurv", "Home", RandomBog, htmlAttributes: new { @class = "btn btn-info btn-info" })
                    </h5>
                    <p class="card-text">
                        @RandomBog.Beskrivelse
                    </p>
                </div>
                }
                <div class="card-footer">

                    @{


                        var antalBoger = db.tblProdukts.Where(boger => boger.FK_ProductCategoryID == 1).Count();



                    }
                    <small class="text-muted">Ialt @antalBoger produkter</small>
                </div>
            </div>

            @* __________________________________________Artikel PÅ FORSIDEN_______________________________________ *@
            <div class="card">
           
               
                    @Html.Action("_OmAnemette", "Home")
              

            </div>
            
        </div>


        


    </div>



