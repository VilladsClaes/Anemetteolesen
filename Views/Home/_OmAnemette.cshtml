@model Anemette.Models.tblArtikel

@* Artiklen "Om-Anemette" kan mangle i databasen - så vises boksen bare ikke *@
@if (Model != null)
{
    if (!String.IsNullOrEmpty(Model.ArtikelBannerBillede))
    {
        <img class="figure-img w-100" src="/Uploads/@Model.ArtikelBannerBillede" alt="@Model.ArtikelManchetTekst" />
    }
    <p class="p-5">@Model.ArtikelTekst</p>
}
