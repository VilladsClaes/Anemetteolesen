@model IEnumerable<Anemette.Models.tblProdukt>
@{
    ViewBag.Title = "Min indkøbskurv";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    int sum = 0;
}


<div id="dvContents">
    <table class="table table-hover" width="100%">
        <thead>

            <tr>
                <th><img src="@Url.Content(Konstanter.BilledemappeSti + "anemette-logo.png")" width="100%" height="70px" /></th>
                <th> Produktnavn </th>
                @*<th > Image </th>*@
                <th> Stykpris </th>
                <th> Fjern fra kurv </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td></td>
                    <td>
                        @item.Navn
                    </td>

                    <td>
                        @item.Pris,- kr
                    </td>
                    <td>
                        <button id="btn_delete" class="label label-primary" data-id="@item.ID" onclick="location.href='@Url.Action("FjernFraKurv","Home",item)'">
                            <span class="">&#128465;</span>
                        </button>
                    </td>

                </tr>
            }
        </tbody>

        @foreach (var item in Model)
        {
            sum = Convert.ToInt32(item.Pris) + sum;
        }
        <tfoot>
            <tr>

                <td></td>
                <td> <b> Total </b></td>
                <td> <b>@sum,- kr</b> </td>
            </tr>
        </tfoot>
    </table>
    <div>
        @*<button type = "button"    id = "btnPrint"    class = "btn btn-primary" > Print </button>*@
        @*<a href="javascript:void(0);" onclick="history.go(-1);" class="btn btn-success">Fortsæt shopping</a>*@
        @Html.ActionLink("Tilbage til sidste side", null, null, null, new { href = Request.UrlReferrer, @class = "btn btn-success btn-lg " })
        @Html.ActionLink("Bestil disse varer", "PlacerOrdre", null, htmlAttributes: new {@class = "btn btn-warning btn-lg " })
        @*<button id="knap" class="btn btn-warning btn-lg">Bestil disse varer</button>*@
    </div>

</div>
