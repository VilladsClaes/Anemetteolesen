@model Anemette.Models.tblProdukt

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm("EditProdukt", "Produkt", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>tblProdukt</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @*  HiddenFor creates a hidden HTML input element containing the ID of the category. This is used in the Bind element of the POST version of the Edit method in the CategoriesController class: public ActionResult Edit([Bind(Include = “ID,Name”)] Category category). *@
    @Html.HiddenFor(model => model.ID)

    <div class="form-group">
        @Html.LabelFor(model => model.Navn, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Navn, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Navn, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Beskrivelse, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Beskrivelse, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Beskrivelse, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Pris, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Pris, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Pris, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Antal, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Antal, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Antal, "", new { @class = "text-danger" })
        </div>
    </div>

    @* ------------------------------------------Produktbillede------------------------------------------------ *@
    @{
        //Anemette.Models.tblBillede skiftbillede = new Anemette.Models.tblBillede();
    }
    <div class="form-group">
        Billede af produkt

        <div class="col-md-10">

            @* Indsæt ekstra billede *@
            <small class="control-label col-md-2">@ViewBag.Billede</small>
            <label for="SamlingAfBilleder">Vælg et eller flere billede</label>
            @* Attributten multiple tillader at vælge flere billeder pr upload. Derfor skal der laves en foreach i controlleren som løber samlingen igennem *@
            @* !!!!!!!!!!!!!!HUSK AT TILFØJE @using (Html.BeginForm("EditProdukt", "Produkt", FormMethod.Post, new { enctype = "multipart/form-data" })) før formularen *@
            <input type="file" multiple name="SamlingAfBilleder" id="SamlingAfBilleder" class="form-control" />
            <span class="text-danger">@ViewBag.Besked</span>


            @*@Html.LabelFor(model => model.Files, htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.TextBoxFor(model => model.Files, new { type = "file", multiple = "" })
                @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })*@


        </div>

    </div>

    <div class="form-group">
        Nuværende billeder
        @{
            foreach (var billede in Model.tblBilledes.ToList())
            {
                <img src="~/Uploads/@billede.BilledeFil" width="200" alt="Billede af @billede.BilledeAlternativTekst" />

            }

        }
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.FK_ProductCategoryID, "FK_ProductCategoryID", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownList("FK_ProductCategoryID", null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.FK_ProductCategoryID, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Save" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Tilbage til produktlisten", "Index")
</div>
