<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>


    <!-- Facebook Open Graph
    Learn more: https://developers.facebook.com/docs/sharing/webmasters -->
    <meta property="og:url" content="https://www.anemetteolesen.dk" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Skarresøhus Forlag v/ Anemette Olesen" />
    <meta property="og:description" content="Forfatter Anemette Olesen Har skrevet adskillige grønne kogebøger og er tidligere restauratør af sommerrestauranten Den Gamle Pavillon i Spøttrup. Jeg bor på Djursland – og har en stor urtehave.I mange år har jeg arbejdet freelance med have og mad, hvilket bl.a. har resulteret i mange madkurser og foredrag over hele landet " />
    <meta property="og:image" content="https://www.anemetteolesen.dk/Uploads/anemette-logo.png" />

    <meta lang="da" />

    @* Googles ikonbibliotek brugt i _Footer *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
    <body  class="container body-content">
       

        

            @* Partial af navigation *@
            @if (Session["LoginBruger"] != null)
            {
                @Html.Action("_Navbar", "Admin")
            }
            else
            {
                @Html.Action("_Navbar", "Home")
            }

            <div class="">
                @RenderBody()
            </div>
            <hr />

            <footer>
                @* Indsætter et parital view som er Footeren *@
                @Html.Action("_Footer", "Home")
            </footer>

        

        @* Disse scripts renderes af BundleConfig.cs-filen i App-start  *@
        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/popper")
        @Scripts.Render("~/bundles/bootstrap")

        @*Hvis der er scripts på denne side skal de samles og afspilles i denne section*@
        @RenderSection("scripts", required: false)

    </body>
</html>
