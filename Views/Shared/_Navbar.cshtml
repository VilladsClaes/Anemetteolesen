            <span class="navbar-toggler-icon"></span>
        </button>



        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">


                <li class="nav-item p-2 pb-sm-2">
                    <div class="nav-link btn border-info">
                        @Html.RouteLink("Produkter", "ProduktOversigt", null, new { @class = "badge" })
                    </div>
                </li>

                @*<li class="nav-item">
                 @Html.ActionLink("Kurser", "Index", "Event", null, new { @class = "nav-link" })
                </li>*@

                <li class="nav-item p-2 pb-sm-2">
